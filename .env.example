# ══════════════════════════════════════════════════════
#  متغيرات البيئة — مركز سرعة انجاز للخدمات
#  أضف هذه المتغيرات في لوحة Render > Environment
# ══════════════════════════════════════════════════════

# منفذ التشغيل (يُعيَّن تلقائياً من Render - لا تغيّره)
PORT=10000

# وضع Render (اتركه true عند النشر)
RENDER=true

# مفتاح الجلسة الأمني — غيّره لقيمة عشوائية طويلة
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_HERE

# مفتاح Groq AI — احصل عليه من console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# إعدادات GitHub (لحفظ الجلسات في المستودع)
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=anwer1230/Anwer_Telegram-
GITHUB_BRANCH=main

# رابط النشر التلقائي Render Deploy Hook
RENDER_DEPLOY_HOOK=https://api.render.com/deploy/srv-daps4mm7bikc738kaflg?key=BSGAfvSu9d4

# PostgreSQL — أنشئ قاعدة PostgreSQL وأضف رابطها كـ Secret باسم DATABASE_URL
# لا تضع بيانات الدخول الحقيقية داخل هذا الملف أو GitHub
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_CONNECT_TIMEOUT=10
DB_RETRIES=2
