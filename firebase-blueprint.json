{
  "entities": {
    "SavedLink": {
      "title": "SavedLink",
      "description": "Telegram group or channel links saved by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "date_saved": { "type": "string" },
        "source": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["url"]
    },
    "SavedPhoneNumber": {
      "title": "SavedPhoneNumber",
      "description": "Phone numbers saved for account authentication and quick selection",
      "type": "object",
      "properties": {
        "phone_number": { "type": "string" },
        "added_at": { "type": "string" },
        "is_default": { "type": "boolean" },
        "label": { "type": "string" }
      },
      "required": ["phone_number"]
    },
    "GroupSafetyReport": {
      "title": "GroupSafetyReport",
      "description": "Permanent safety analysis, bot inspection and verification reports for Telegram groups",
      "type": "object",
      "properties": {
        "group_key": { "type": "string" },
        "group_id": { "type": "string" },
        "group_title": { "type": "string" },
        "username": { "type": "string" },
        "is_protected": { "type": "boolean" },
        "blocks_ads": { "type": "boolean" },
        "requires_smart_send": { "type": "boolean" },
        "risk_assessment": { "type": "string" },
        "causes": { "type": "array" },
        "mistakes_by_others": { "type": "array" },
        "prohibited_actions": { "type": "array" },
        "keywords_to_avoid": { "type": "array" },
        "summary_ar": { "type": "string" },
        "recommended_action": { "type": "string" },
        "can_send_media": { "type": "boolean" },
        "analyzed_at": { "type": "string" }
      },
      "required": ["group_key"]
    }
  },
  "firestore": {
    "/saved_links/{linkId}": {
      "schema": "SavedLink",
      "description": "Collection of permanent saved telegram links"
    },
    "/saved_phone_numbers/{phoneId}": {
      "schema": "SavedPhoneNumber",
      "description": "Collection of permanent saved phone numbers for account addition"
    },
    "/group_safety_reports/{reportId}": {
      "schema": "GroupSafetyReport",
      "description": "Collection of permanent safety analysis and verification reports for groups"
    }
  }
}
